+    _ROUTED_EXPERT_RE = re.compile(r"^model\.layers\.(\d+)\.mlp\.experts\.(\d+)\.")
+
+    def _is_local_routed_expert(self, name: str) -> bool:
+        m = self._ROUTED_EXPERT_RE.match(name)
+        if m is None or self.model is None:
+            return True
+        layer_id = int(m.group(1))
+        if not 0 <= layer_id < len(self.model.layers):
+            return True
+        experts = getattr(getattr(self.model.layers[layer_id], "mlp", None), "experts", None)
+        mapper = getattr(experts, "_map_global_expert_id_to_local_expert_id", None)
+        return mapper is None or mapper(int(m.group(2))) >= 0
+
