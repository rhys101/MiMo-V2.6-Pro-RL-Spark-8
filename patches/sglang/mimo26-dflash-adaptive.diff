+# mimo26: adaptive DFLASH verify width. A second, narrower target-verify graph
+# runner shares this backend; it must not reallocate the full-width runner's
+# graph buffers, and narrow verifies need their own metadata (static
+# cu_seqlens_q stride, per-bs metadata objects) and width.
+import contextlib as _mimo26_contextlib
+
+
+@_mimo26_contextlib.contextmanager
+def _mimo26_verify_width(self, forward_batch):
+    spec_info = getattr(forward_batch, "spec_info", None)
+    width = getattr(spec_info, "num_tokens_per_req", -1) if spec_info is not None else -1
+    full = getattr(self, "_mimo26_full_width", None) or self.speculative_num_draft_tokens
+    if (
+        not forward_batch.forward_mode.is_target_verify()
+        or self.topk > 1
+        or width is None
+        or width <= 0
+        or not full
+        or width == full
+    ):
+        yield
+        return
+    saved_width = self.speculative_num_draft_tokens
+    saved_meta = self.target_verify_metadata
+    base = saved_meta
+    if isinstance(base, dict) and "cache_seqlens" in base:
+        cache = self.__dict__.setdefault("_mimo26_tv_meta", {})
+        meta = cache.get(width)
+        if meta is None:
+            max_bs = base["cache_seqlens"].shape[0]
+            meta = {
+                k: torch.zeros_like(v)
+                for k, v in base.items()
+                if isinstance(k, str) and k not in ("cu_seqlens_q", "strided_indices")
+            }
+            meta["strided_indices"] = base["strided_indices"]
+            meta["cu_seqlens_q"] = torch.arange(
+                0, max_bs * width + 1, step=width, dtype=torch.int32, device=self.device
+            )
+            cache[width] = meta
+        self.target_verify_metadata = meta
+    self.speculative_num_draft_tokens = width
+    try:
+        yield
+    finally:
+        self.speculative_num_draft_tokens = saved_width
+        self.target_verify_metadata = saved_meta
+
+
+def _mimo26_wrap_metadata(name):
+    orig = getattr(FlashAttentionBackend, name)
+
+    def wrapper(self, forward_batch, *args, **kwargs):
+        with _mimo26_verify_width(self, forward_batch):
+            return orig(self, forward_batch, *args, **kwargs)
+
+    wrapper.__name__ = name
+    wrapper.__doc__ = orig.__doc__
+    return wrapper
+
+
+def _mimo26_wrap_graph_state():
+    orig = FlashAttentionBackend.init_cuda_graph_state
+
+    def init_cuda_graph_state(self, max_bs: int, max_num_tokens: int):
+        prev = getattr(self, "_mimo26_graph_state_dims", None)
+        if prev is not None and prev[0] >= max_bs and prev[1] >= max_num_tokens:
+            return
+        orig(self, max_bs, max_num_tokens)
+        self._mimo26_graph_state_dims = (max_bs, max_num_tokens)
+        self._mimo26_full_width = self.speculative_num_draft_tokens
+        self._mimo26_tv_meta = {}
+
+    init_cuda_graph_state.__doc__ = orig.__doc__
+    return init_cuda_graph_state
+
+
+for _mimo26_name in ("init_forward_metadata", "init_forward_metadata_out_graph"):
+    setattr(FlashAttentionBackend, _mimo26_name, _mimo26_wrap_metadata(_mimo26_name))
+FlashAttentionBackend.init_cuda_graph_state = _mimo26_wrap_graph_state()
