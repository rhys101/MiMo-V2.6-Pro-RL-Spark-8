+            return
+        original = tmr.decode_num_tokens_per_req
+        tmr.decode_num_tokens_per_req = lambda **kwargs: small
+        try:
+            runner = tmr._decode_cuda_graph_runner_cls()(tmr)
+        finally:
+            tmr.decode_num_tokens_per_req = original
+        tmr.mimo26_alt_verify_runners = {small: runner}
+        self._mimo26_widths = [small]
+        logger.info(
+            "mimo26: adaptive DFLASH verify width %d/%d (lo=%.2f hi=%.2f alpha=%.2f)",
+            small, full, self._mimo26_lo, self._mimo26_hi, self._mimo26_alpha,
+        )
+
+    def _mimo26_choose_width(self, batch) -> int:
+        """Full block if any request is accepting well, else the narrow width.
+
+        Uses the scheduler's per-request counters (identical on every TP rank, one
+        step behind under overlap scheduling): an EMA of correct drafts per verify,
+        with hysteresis between MIMO26_DFLASH_LO and MIMO26_DFLASH_HI.
+        """
+        full = self._mimo26_full_block
+        if getattr(self, "_selector_sample", None) is not None:
+            return full
+        use_full = False
+        for req in batch.reqs:
+            state = getattr(req, "_mimo26_adaptive", None)
+            verify_ct = int(getattr(req, "spec_verify_ct", 0))
+            correct = int(getattr(req, "spec_num_correct_drafts", 0))
+            if state is None:
+                state = [verify_ct, correct, None, True]
+                req._mimo26_adaptive = state
+            steps = verify_ct - state[0]
+            if steps > 0:
+                rate = (correct - state[1]) / steps
+                ema = state[2]
+                state[2] = rate if ema is None else (1.0 - self._mimo26_alpha) * ema + self._mimo26_alpha * rate
+                state[0], state[1] = verify_ct, correct
+            if state[2] is not None:
+                if state[3] and state[2] < self._mimo26_lo:
+                    state[3] = False
+                elif not state[3] and state[2] >= self._mimo26_hi:
+                    state[3] = True
+            use_full = use_full or state[3]
+        return full if use_full else self._mimo26_widths[0]
 
