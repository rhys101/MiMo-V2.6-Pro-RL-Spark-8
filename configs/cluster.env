# Cluster profile for 8 x DGX Spark, sourced by scripts/cluster.sh on the head node.
# Replace the placeholder values below, or put your own values in the git-ignored
# configs/cluster.local.env, which is sourced after this file.

SSH_USER=spark                      # account on every node (passwordless SSH from the head)
NODES="node1 node2 node3 node4 node5 node6 node7 node8"   # rank order; node1 = head / rank 0
# Fabric addresses of each node on the two ConnectX-7 RoCE subnets (bulk transfer,
# NCCL and RoCEnante). Never use the management NIC for bulk traffic.
FABRIC_A="10.0.100.1 10.0.100.2 10.0.100.3 10.0.100.4 10.0.100.5 10.0.100.6 10.0.100.7 10.0.100.8"
FABRIC_B="10.0.101.1 10.0.101.2 10.0.101.3 10.0.101.4 10.0.101.5 10.0.101.6 10.0.101.7 10.0.101.8"
BUILD_NODE=node7                    # node with free disk to build the image on
WORKDIR='$HOME/mimo-v2.6-pro'       # expanded on each node
MODEL_DIR='$HOME/models/MiMo-V2.6-Pro-RL'
IMAGE=mimo26-spark:a6
CTN_PREFIX=mimo26-r
DIST_INIT_ADDR=10.0.100.1:20000     # head node fabric address

# DGX Spark default device names; check with `ibdev2netdev`.
FABRIC_IFACES="enp1s0f0np0 enP2p1s0f0np0"
ROCE_HCAS="rocep1s0f0 roceP2p1s0f0"

# NCCL over both RoCE HCAs (same settings as the tuned DeepSeek V4.1 deployment).
NCCL_ENV="NCCL_NET=IB NCCL_IB_DISABLE=0 NCCL_IB_HCA==rocep1s0f0:1,roceP2p1s0f0:1 NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_SOCKET_IFNAME==enp1s0f0np0 GLOO_SOCKET_IFNAME=enp1s0f0np0 NCCL_CUMEM_ENABLE=0 NCCL_NVLS_ENABLE=0
NCCL_PROTO=^LL128 NCCL_BUFFSIZE=1048576 NCCL_LL128_BUFFSIZE=262144 NCCL_MAX_NCHANNELS=8 NCCL_DEBUG=WARN
SGLANG8_ROCE_ALLREDUCE=1"

# Serving profile (read by runtime/serve.sh).
SERVE_ENV="TP_SIZE=8 EP_SIZE=1 NNODES=8 API_PORT=30000 SERVED_MODEL_NAME=mimo-v2.6-pro
ATTN_BACKEND=triton PREFILL_ATTN_BACKEND=fa4 MM_ATTN_BACKEND=triton_attn MOE_RUNNER_BACKEND=marlin MOE_A2A_BACKEND=none
MEM_FRACTION_STATIC=0.85 CONTEXT_LENGTH=262144 MAX_RUNNING_REQUESTS=8 CHUNKED_PREFILL_SIZE=8192
PAGE_SIZE=64 SWA_FULL_TOKENS_RATIO=0.1 ENABLE_VISION=1
SPEC_ALGO=DFLASH SPEC_DRAFT_TOKENS=8 CUDA_GRAPH=1 CUDA_GRAPH_MAX_BS=8"
